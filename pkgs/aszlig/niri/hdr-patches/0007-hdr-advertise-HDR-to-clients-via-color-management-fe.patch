+fn fixture_with_hdr_mode_on() -> Fixture {
+    use niri_config::output::HdrMode;
+
+    let mut config = Config::default();
+    config.outputs.0.push(Output {
+        name: "headless-1".to_owned(),
+        hdr: Some(Hdr {
+            mode: HdrMode::On,
+            ..Default::default()
+        }),
+        ..Default::default()
+    });
+    let mut f = Fixture::with_config(config);
