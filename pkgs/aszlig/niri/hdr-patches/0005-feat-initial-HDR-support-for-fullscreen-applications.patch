+    // surface, as mpv --vo=gpu-next does for HDR content.
+    f.client(id).create_and_attach_hdr_description(
+        &surface,
+        TransferFunction::St2084Pq,
+        Primaries::Bt2020,
+        RenderIntent::Perceptual,
+    );
+    f.double_roundtrip(id);
+}
