diff --git a/anyrun/res/style.css b/anyrun/res/style.css
index 32d0e7e..3ea92b2 100644
--- a/anyrun/res/style.css
+++ b/anyrun/res/style.css
@@ -1,76 +1,25 @@
-@define-color accent #5599d2;
-@define-color bg-color #161616;
-@define-color fg-color #eeeeee;
-@define-color desc-color #cccccc;
-
 window {
-  background: transparent;
+  background-color: rgba(0, 0, 0, 0);
 }
 
-box.main {
-  padding: 5px;
-  margin: 10px;
+box#main {
   border-radius: 10px;
-  border: 2px solid @accent;
-  background-color: @bg-color;
-  box-shadow: 0 0 5px black;
+  background-color: #161616;
 }
 
-
-text {
-  min-height: 30px;
-  padding: 5px;
-  border-radius: 5px;
-  color: @fg-color;
-}
-
-.matches {
+list#main {
   background-color: rgba(0, 0, 0, 0);
   border-radius: 10px;
 }
 
-box.plugin:first-child {
-  margin-top: 5px;
-}
-
-box.plugin.info {
-  min-width: 200px;
-}
-
-list.plugin {
+list#plugin {
   background-color: rgba(0, 0, 0, 0);
 }
 
-label.match {
-  color: @fg-color;
-}
-
-label.match.description {
+label#match-desc {
   font-size: 10px;
-  color: @desc-color;
 }
 
-label.plugin.info {
+label#plugin {
   font-size: 14px;
-  color: @fg-color;
 }
-
-.match {
-  background: transparent;
-}
-
-.match:selected {
-  border-left: 4px solid @accent;
-  background: transparent;
-  animation: fade 0.1s linear;
-}
-
-@keyframes fade {
-  0% {
-    opacity: 0;
-  }
-
-  100% {
-    opacity: 1;
-  }
-}
\ No newline at end of file
